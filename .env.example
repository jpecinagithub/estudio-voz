# ─── Servidor (Vercel Functions — nunca exponer en el navegador) ───
# Clave de la API de Groq para la transcripción de audio a texto.
GROQ_API_KEY=

# Token de Vercel Blob para la subida optimizada de archivos grandes (opcional).
# Solo se usa cuando un audio supera el tamaño que admite una Function directamente.
BLOB_READ_WRITE_TOKEN=
